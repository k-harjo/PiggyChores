rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInParent(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The parent account owns the household data, including child profiles.
    // A child profile and optional PIN are an in-app convenience, not a
    // separate Firebase security boundary.
    match /users/{userId} {
      allow read, write: if isSignedInParent(userId);

      match /{document=**} {
        allow read, write: if isSignedInParent(userId);
      }
    }

    // Family-specific settings are stored under /users/{parentUid}/settings.
    match /config/{document=**} {
      allow read, write: if false;
    }

    // Deny all unmodeled paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

