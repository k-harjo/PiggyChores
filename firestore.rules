rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParent(parentId) {
      return signedIn() && request.auth.uid == parentId;
    }

    function childPath(parentId, childId) {
      return /databases/$(database)/documents/users/$(parentId)/children/$(childId);
    }

    // Child profiles used to contain readable PINs. A linked child can access
    // their profile only after the parent removes any legacy PIN field.
    function isLinkedChild(parentId, childId) {
      return signedIn()
        && exists(childPath(parentId, childId))
        && childId == request.auth.uid
        && get(childPath(parentId, childId)).data.authUid == request.auth.uid
        && !('pin' in get(childPath(parentId, childId)).data);
    }

    function canReadChore(parentId) {
      return isParent(parentId)
        || (isLinkedChild(parentId, request.auth.uid)
            && ((resource.data.status == 'UNASSIGNED'
                 && resource.data.assignedToChildId == null)
                || resource.data.assignedToChildId == request.auth.uid));
    }

    match /users/{parentId} {
      allow read, write: if isParent(parentId);

      // Preserve parent access to household collections while child access is
      // granted only by the narrower rules below.
      match /{subcollection}/{document=**} {
        allow read, write: if isParent(parentId);
      }

      match /children/{childId} {
        allow get: if isParent(parentId) || isLinkedChild(parentId, childId);
        allow list: if isParent(parentId);
        allow create, delete: if isParent(parentId);
        allow update: if isParent(parentId)
          || (isLinkedChild(parentId, childId)
              && request.resource.data.authUid == resource.data.authUid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['color', 'icon']));
      }

      match /chores/{choreId} {
        allow get, list: if isParent(parentId) || canReadChore(parentId);
        allow create, delete: if isParent(parentId);
        allow update: if isParent(parentId)
          || childCanUpdateChore(parentId);
      }

      match /archived_chores/{archiveId} {
        allow read: if isParent(parentId)
          || (resource.data.assignedToChildId != null
              && isLinkedChild(parentId, resource.data.assignedToChildId));
        allow write: if isParent(parentId);
      }

      match /settings/{settingId} {
        allow read, write: if isParent(parentId);
      }
    }

    function childCanUpdateChore(parentId) {
      let childId = request.auth.uid;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isLinkedChild(parentId, childId)
        && (
          (resource.data.status == 'ASSIGNED'
            && resource.data.assignedToChildId == childId
            && request.resource.data.status == 'COMPLETED'
            && request.resource.data.completedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.assignedToChildId == childId
            && request.resource.data.completedByChildId == childId
            && changed.hasOnly(['status', 'completedAt', 'completedByChildId', 'updatedAt']))
          || (resource.data.status == 'ASSIGNED'
            && resource.data.assignedToChildId == childId
            && request.resource.data.status == 'UNASSIGNED'
            && request.resource.data.assignedToChildId == null
            && request.resource.data.updatedAt == request.time
            && changed.hasOnly(['status', 'assignedToChildId', 'updatedAt']))
          || (resource.data.status == 'UNASSIGNED'
            && resource.data.assignedToChildId == null
            && request.resource.data.status == 'ASSIGNED'
            && request.resource.data.assignedToChildId == childId
            && request.resource.data.updatedAt == request.time
            && changed.hasOnly(['status', 'assignedToChildId', 'updatedAt']))
        );
    }

    // No shared, top-level configuration or unmodeled data is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

